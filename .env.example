# Copy this file to .env in the project root for local `npm run dev` and `netlify dev`.
# Get a key from https://grok.com/dashboard/api-keys or https://console.x.ai
# It should start with xai-. Never commit the real value.
# On Netlify, set XAI_API_KEY (and optionally XAI_MODEL) as site environment variables.
# Do not prefix the key with VITE_ — that would expose it to the browser.

XAI_API_KEY=

# Optional. Used for anomaly investigation. Defaults to grok-4.7.
XAI_MODEL=grok-4.7

# Local API port for `npm run dev`. Netlify does not use this.
PORT=3001
